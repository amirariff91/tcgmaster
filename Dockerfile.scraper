# Scraper workers — deployed as a SEPARATE Coolify Application from the same repo.
#
# Not Coolify Scheduled Tasks: those are a cron'd `docker exec` into a container, but
# scripts/price-engine/queue-*.ts are while(true) daemons that never exit, so a task
# would hang with no timeout. PM2 supervises them here instead; Coolify restarts the
# container. Keeping this separate also means a scraper crash can't take down the site.
#
# Unlike the web image, this one DOES want Chrome: lib/price-engine/snkrdunk.ts and
# pricecharting.ts drive puppeteer.
FROM node:22-slim

WORKDIR /app

# unzip is what puppeteer's postinstall needs to extract Chrome — its absence is what
# broke the web build. The rest are Chrome's shared-library runtime deps.
RUN apt-get update && apt-get install -y --no-install-recommends \
      unzip \
      ca-certificates \
      fonts-liberation \
      libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
      libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libgbm1 libasound2 libpango-1.0-0 libcairo2 \
    && rm -rf /var/lib/apt/lists/*

# PM2 runs the workers via `bun` (ecosystem.config.cjs). The scripts use no Bun-specific
# APIs — bun is only the TypeScript runner — but keep it so the container matches local.
RUN npm install -g pm2 && \
    npm install -g bun

COPY package.json package-lock.json* ./

# No PUPPETEER_SKIP_DOWNLOAD here: Chrome is required at runtime. Fails loudly.
RUN npm ci

COPY . .

# pm2-runtime, not `pm2 start`: it stays in the foreground as PID 1 so Docker can
# supervise and restart it.
CMD ["pm2-runtime", "ecosystem.config.cjs"]
