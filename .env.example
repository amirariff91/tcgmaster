# Copy to .env.local and fill in. Values live in Coolify for deployed environments.
# Some standalone scripts (scripts/check-schema.ts, scripts/test-card-data.ts) read a
# physical .env instead of .env.local — copy this there too if you use them.

# ============== Web app (required) ==============
# lib/db/client.ts — self-hosted Postgres 16. Builds fail soft without it; runtime
# reads/writes fail. No URL-encoding needed for alphanumeric passwords.
DATABASE_URL=
# lib/auth.ts — REQUIRED in production. No safe fallback; a missing value makes
# sessions forgeable. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BETTER_AUTH_SECRET=
# lib/auth.ts — REQUIRED in production (https://tcgmaster.com). Missing -> localhost cookies/callbacks.
BETTER_AUTH_URL=
# app/api/cards/[id]/sources/route.ts — comma-separated curator emails allowed to edit
# card scraper URLs. If empty, the endpoint denies everyone.
ADMIN_EMAILS=

# ============== Legacy Supabase (rollback ONLY) ==============
# Retained so pointing git_branch back at `main` (pre-migration) works during the soak
# window. No current production code reads them except the 17 manual scripts +
# lib/supabase/client.ts. Not needed for the migrated app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

POKEMON_TCG_API_KEY=
PPT_API_KEY=

# app/api/cron/trending/route.ts and app/api/revalidate/card/route.ts deny every
# request unless this is set and the caller sends `Authorization: Bearer <value>`.
# Leaving it unset disables those endpoints rather than exposing them.
# NOTE: the scraper container needs this too — see the scrapers section below.
CRON_SECRET=

# ============== Analytics (optional) ==============
# Google Tag Manager — manages GA4, Clarity, and all tracking tags
NEXT_PUBLIC_GTM_ID=
# Google Search Console site-verification token (meta tag value)
NEXT_PUBLIC_GSC_VERIFICATION=
# lib/api/one-piece-fetcher.ts
OPTCG_API_KEY=
RAPIDAPI_KEY=

# ============== Scrapers only (Dockerfile.scraper / PM2) ==============
# scripts/extract-artists.ts — vision artist extraction via Ollama Cloud.
# Without this the artist worker exits; the 3 price scrapers are unaffected.
# Key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_VISION_MODEL=gemma4:31b
# Optional path to the PSA browser cookie jar. Keep it outside the repository.
# Defaults to ~/.tcgmaster/psa-cookies.json.
PSA_COOKIE_PATH=
# scripts/generate-variant-mapping.ts (one-off script) still uses Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# 1 = slower scrape intervals, lower ban risk (ecosystem.config.cjs)
SAFE_MODE=
# Origin of the web app, e.g. https://tcgmaster.com — the scrapers POST here after
# a price write so the card page's ISR entry is purged (card pages cache for 24h).
# Runtime variable, NOT a build variable. Leave unset and the scrapers still run
# normally; card pages just wait out the TTL instead of updating on write.
# Requires CRON_SECRET (above) to be set on the scraper container too, matching
# the web app's value — without it every purge is silently skipped.
REVALIDATE_URL=
