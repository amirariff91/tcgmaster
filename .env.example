# Copy to .env.local and fill in. Values live in Coolify for deployed environments.
# Some standalone scripts (scripts/check-schema.ts, scripts/test-card-data.ts) read a
# physical .env instead of .env.local — copy this there too if you use them.

# ============== Web app (required) ==============
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key — safe to ship to the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — service_role. Bypasses RLS. Server-side only, never expose.
SUPABASE_SECRET_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

POKEMON_TCG_API_KEY=
PPT_API_KEY=

# app/api/cron/trending/route.ts denies every request unless this is set and the
# caller sends `Authorization: Bearer <value>`. Leaving it unset disables the
# trending recompute rather than exposing it.
CRON_SECRET=

# ============== Web app (optional) ==============
# app/layout.tsx
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# lib/api/one-piece-fetcher.ts
OPTCG_API_KEY=
RAPIDAPI_KEY=

# ============== Scrapers only (Dockerfile.scraper / PM2) ==============
# scripts/extract-artists-gemini.ts, scripts/generate-variant-mapping.ts
GEMINI_API_KEY=
GEMINI_MODEL=
# 1 = slower scrape intervals, lower ban risk (ecosystem.config.cjs)
SAFE_MODE=
