# ==========================================
# TCGMaster Environment Configuration
# ==========================================

# ------------------------------------------
# Next.js / Server Settings
# ------------------------------------------
NIXPACKS_NODE_VERSION=22

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# If hosting on Coolify, this will be your self-hosted Supabase URL and keys.
NEXT_PUBLIC_SUPABASE_URL=http://<coolify-supabase-ip>:8000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# ------------------------------------------
# Rate Limiting & Queueing (Upstash Redis)
# ------------------------------------------
# Highly recommended to use Upstash or your own Redis instance for rate limiting the scrapers.
UPSTASH_REDIS_REST_URL=your-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token

# ------------------------------------------
# Analytics (Optional)
# ------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------
# Price Engine & Scraper APIs (Optional depending on usage)
# ------------------------------------------
POKEMON_TCG_API_KEY=your-pokemon-tcg-api-key
PPT_API_KEY=your-pokeprice-pro-key

# ------------------------------------------
# AI Assistants / OCR (Optional)
# ------------------------------------------
GEMINI_API_KEY=your-gemini-key
OLLAMA_API_KEY=your-ollama-key
